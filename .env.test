# Test Environment Variables for VS Code Test Explorer
# This file is loaded by VS Code's python.envFile setting

# CRITICAL: Test database ports (not production!)
APP_ENV=test
TESTING=true

# Qdrant Test Configuration (port 6335, not 6333)
QDRANT_HOST=localhost
QDRANT_PORT=6335
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION_NAME=financial_docs_test

# PostgreSQL Test Configuration (port 5433, not 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=raglite_ci
POSTGRES_USER=raglite_ci
POSTGRES_PASSWORD=raglite_ci

# Embedding Model Configuration
EMBEDDING_MODEL=intfloat/e5-large-v2
EMBEDDING_DIMENSION=1024

# MCP Server Configuration
MCP_SERVER_PORT=8000

# Test PDF Location
TEST_PDF_PATH=/Users/ricardocarvalho/DeveloperFolder/RAGLite/docs/sample pdf/2025-08 Performance Review CONSO_v2.pdf

# Mistral API Configuration (dummy key for unit tests, real key for integration)
MISTRAL_API_KEY=test-mistral-api-key-for-ci
METADATA_EXTRACTION_MODEL=mistral-small-latest
