[bandit]
# Bandit security linter configuration for RAGLite
#
# False Positive Exclusions:
# - B608: hardcoded_sql_expressions - All SQL queries use proper parameterization
#   All flagged queries follow the pattern: cursor.execute(query, params_tuple)
#   This is secure as parameters are properly bound by the database driver.
#
# - B310: urllib_urlopen - URL scheme validation is enforced before urllib.request.urlopen
#   See raglite/mcp/tools/ingestion.py lines 278-282 for validation logic
#   Only http/https schemes are allowed via ALLOWED_URL_SCHEMES
#
# Documentation: docs/architecture/security.md (when created)
# CI Workflow: .github/workflows/ci.yml -> bandit scan job

exclude_dirs = [
    '/usr/local/lib',
    'venv',
    '.venv',
    'tests',
    'scripts'
]

tests = [
    # B201: flask_debug_true (checked in deployment)
    # B301: pickle (not used - we use json)
    # B302: marshal (not used)
    # B303: md5 (not used for security)
    # B304: ciphers (not used)
    # B305: cipher_modes (not used)
    # B306: mktemp_q (not used)
    # B307: eval (not used)
    # B308: mark_safe (not using Django)
    # B309: httpsconnection (verified for HTTPS only)
    # B310: urllib_urlopen (validated with scheme check)
    # B311: random (not used for security)
    # B312: telnetlib (not used)
    # B313: xml_bad_cElementTree (not used)
    # B314: xml_bad_ElementTree (not used)
    # B315: xml_bad_expatreader (not used)
    # B316: xml_bad_expatbuilder (not used)
    # B317: xml_bad_sax (not used)
    # B318: xml_bad_minidom (not used)
    # B319: xml_bad_pulldom (not used)
    # B320: xml_bad_etree (not used)
    # B321: ftplib (not used)
    # B322: input (not applicable in Python 3)
    # B323: unverified_context (not used)
    # B324: hashlib_new_insecure_functions (verified usage)
    # B325: tempnam (not used)
    # B401: import_telnetlib (not used)
    # B402: import_ftplib (not used)
    # B403: import_pickle (not used)
    # B404: import_subprocess (verified safe usage)
    # B405: import_xml_etree (not used)
    # B406: import_xml_sax (not used)
    # B407: import_xml_expat (not used)
    # B408: import_xml_minidom (not used)
    # B409: import_xml_pulldom (not used)
    # B410: import_lxml (not used)
    # B411: import_xmlrpclib (not used)
    # B412: import_httpoxy (not applicable)
    # B413: import_pycrypto (not used)
    # B501: secure_with_ssl (verified)
    # B502: ssl_with_bad_version (verified)
    # B503: ssl_with_bad_defaults (verified)
    # B504: ssl_with_no_version (verified)
    # B505: weak_cryptographic_key (verified)
    # B506: yaml_load (not used)
    # B507: ssh_no_host_key_verification (not used)
    # B601: paramiko_calls (not used)
    # B602: subprocess_popen_with_shell_equals_true (verified safe)
    # B603: subprocess_without_shell_equals_true (verified safe)
    # B604: any_other_function_with_shell_equals_true (not used)
    # B605: start_process_with_a_shell (not used)
    # B606: start_process_with_no_shell (not used)
    # B607: start_process_with_partial_path (not used)
    # B608: hardcoded_sql_expressions (FALSE POSITIVE - all use parameterized queries)
    # B609: linux_commands_wildcard_injection (not used)
    # B610: django_extra_used (not using Django)
    # B611: django_rawsql_used (not using Django)
    # B701: jinja2_autoescape_false (not using Jinja2)
    # B702: use_of_mako_templates (not using Mako)
    # B703: django_mark_safe (not using Django)
]
